{
    "name": "macbid-ts-api",
    "version": "1.2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pkmnct/macbid-ts-api.git"
    },
    "author": "George W. Walker",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/pkmnct/macbid-ts-api/issues"
    },
    "engines": {
        "node": ">=22"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.0.0",
        "eslint": "^10.14.0",
        "eslint-plugin-promise": "^7.3.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.2"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "prepublishOnly": "npm run build"
    },
    "type": "module",
    "main": "index.js",
    "types": "index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "default": "./index.js"
        }
    },
    "files": [
        "*.js",
        "*.d.ts",
        "*.map",
        "!eslint.config.js"
    ]
}
